# ---------------------------------------------------------------------------
# Compliance Research Agent — environment variables
# Copy to `.env.local` and fill in. Every variable below is parsed and
# validated by Zod in `lib/env.ts`; the app refuses to boot on a bad config.
# ---------------------------------------------------------------------------

# --- Models -----------------------------------------------------------------
# Required. Used for embeddings (text-embedding-3-small) and as a synthesis model.
OPENAI_API_KEY=sk-...
# Optional. When present, the synthesizer/verifier nodes can run on Claude.
ANTHROPIC_API_KEY=sk-ant-...
# Which provider drives the agent's reasoning nodes: "openai" | "anthropic"
AGENT_PROVIDER=openai

# --- Vector store -----------------------------------------------------------
# "supabase" (pgvector + tsvector BM25, recommended) or "pinecone"
VECTOR_STORE=supabase

# Supabase (required when VECTOR_STORE=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Pinecone (required when VECTOR_STORE=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX=compliance-research

# --- Reranking --------------------------------------------------------------
# Optional. Without it the pipeline degrades gracefully to RRF-only ordering.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# --- Observability ----------------------------------------------------------
# Optional. Without these, tracing becomes a no-op and the app still runs.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Background jobs (Inngest) ----------------------------------------------
# Leave empty for local `inngest-cli dev`; required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Web search fallback ----------------------------------------------------
# Optional. Without a key the WebSearchTool node returns a clearly-labelled
# mock result instead of silently pretending to have searched the web.
TAVILY_API_KEY=

# --- RAG hyperparameters (tunable without a code change) --------------------
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=60
RRF_K=60
RRF_DENSE_WEIGHT=1.0
RRF_SPARSE_WEIGHT=0.8
RETRIEVAL_CANDIDATES=20
RERANK_TOP_N=4
RERANK_SCORE_THRESHOLD=0.25
